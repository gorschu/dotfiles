#!/bin/bash
# Generate Bash and Zsh completions for Zed.

set -euo pipefail

if ! command -v zed &>/dev/null; then
  echo "Zed not found, skipping shell completions"
  exit 0
fi

echo "Generating Zed shell completions..."

# Generate both before replacing files so errors leave existing completions intact.
bash_completion=$(zed --completions bash)
zsh_completion=$(zed --completions zsh)

BASH_COMPLETIONS="${XDG_DATA_HOME:-${HOME}/.local/share}/bash-completion/completions"
ZSH_COMPLETIONS="${HOME}/.zsh/.zsh_completions.d"

mkdir -p "${BASH_COMPLETIONS}" "${ZSH_COMPLETIONS}"
printf '%s\n' "$bash_completion" >"${BASH_COMPLETIONS}/zed"
printf '%s\n' "$zsh_completion" >"${ZSH_COMPLETIONS}/_zed"
