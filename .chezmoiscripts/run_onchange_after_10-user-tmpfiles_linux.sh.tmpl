#!/bin/bash
# run_onchange_after - applies user tmpfiles.d configuration
{{- $configs := "" -}}
{{- range glob (joinPath .chezmoi.sourceDir "private_dot_config/exact_private_user-tmpfiles.d/*") -}}
{{- $configs = print $configs (include .) -}}
{{- end -}}
# Config hash: {{ $configs | sha256sum }}

set -euo pipefail

"$CHEZMOI_SOURCE_DIR/bootstrap/heading.sh" "User tmpfiles"

echo "Applying user tmpfiles.d configuration..."
systemd-tmpfiles --user --create

echo "✓ User tmpfiles.d applied"
