#!/usr/bin/env bash
{{- $filing := joinPath .chezmoi.sourceDir "secrets" "mail-filing.json.asc" | include | decrypt | fromJson }}
# Mail sync wrapper for mbsync/neomutt

set -euo pipefail

LOG_DIR="${HOME}/.local/state/mbsync"
LOG_FILE="${LOG_DIR}/sync.log"
LOCK_FILE="${LOG_DIR}/sync.lock"

# Ensure log directory exists
mkdir -p "${LOG_DIR}"

# Prevent concurrent syncs
exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  echo "Another sync is already running"
  exit 0
fi

log() {
  local msg
  msg="$(date -Iseconds) $*"
  echo "${msg}" >>"${LOG_FILE}"
  echo "$*"
}

notify_error() {
  local msg="$1"
  log "ERROR: ${msg}"
  if command -v notify-send &>/dev/null; then
    notify-send -u critical -t 10000 "Mail Sync Failed" "${msg}"
  fi
}

log "Starting mail sync"

# Check every afew destination before downloading or processing any messages.
filing_folders=(
{{ range $account := $filing.accounts -}}
{{ range $filing.rules -}}
  {{ printf "%s/%s/%s" $account $filing.parent .folder | quote }}
{{ end -}}
{{ end -}}
)
missing_folders=()
for folder in "${filing_folders[@]}"; do
  maildir="${HOME}/data/mail/${folder}"
  if [[ ! -d "${maildir}/cur" || ! -d "${maildir}/new" || ! -d "${maildir}/tmp" ]]; then
    missing_folders+=("${maildir}")
  fi
done
if ((${#missing_folders[@]})); then
  notify_error "Missing filing Maildirs (cur/new/tmp required): ${missing_folders[*]}"
  exit 1
fi

# Check for network connectivity before attempting sync
if command -v nm-online &>/dev/null; then
  if ! nm-online -q -t 5; then
    log "No network connectivity (NetworkManager offline), skipping sync"
    exit 0
  fi
elif ! getent hosts {{ range .mail.accounts }}{{ .imap_host }}{{ break }}{{ end }} &>/dev/null; then
  log "No network connectivity (DNS resolution failed), skipping sync"
  exit 0
fi

# Run mbsync for all accounts, retrying transient network failures before
# notifying the user.
MBSYNC_ATTEMPTS=3
for ((attempt = 1; attempt <= MBSYNC_ATTEMPTS; attempt++)); do
  if {{ lookPath "mbsync" | default (printf "%s/bin/mbsync" .homebrew.prefix) }} -a 2>&1 | tee -a "${LOG_FILE}"; then
    break
  fi

  if ((attempt == MBSYNC_ATTEMPTS)); then
    notify_error "mbsync failed after ${MBSYNC_ATTEMPTS} attempts - check ${LOG_FILE}"
    exit 1
  fi

  log "mbsync attempt ${attempt}/${MBSYNC_ATTEMPTS} failed; retrying in 15 seconds"
  sleep 15
done

log "mbsync completed, running notmuch"

# Index new mail
if ! {{ lookPath "notmuch" | default (printf "%s/bin/notmuch" .homebrew.prefix) }} new 2>&1 | tee -a "${LOG_FILE}"; then
  notify_error "notmuch indexing failed - check ${LOG_FILE}"
  exit 1
fi

log "Sync completed successfully"
