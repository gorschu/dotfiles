#!/bin/bash
{{- $notmuch := lookPath "notmuch" | default (printf "%s/bin/notmuch" .homebrew.prefix) }}
set -euo pipefail

NOTMUCH_BIN={{ $notmuch | quote }}
MISE_BIN={{ joinPath .homebrew.prefix "bin/mise" | quote }}
PATH="$(dirname "$NOTMUCH_BIN")":{{ printf "%s/bin:%s/sbin" .homebrew.prefix .homebrew.prefix | quote }}:"${PATH}"
export PATH
# afew does not discover notmuch's XDG profile configuration itself.
export NOTMUCH_CONFIG="${NOTMUCH_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/notmuch/${NOTMUCH_PROFILE:-default}/config}"

afew() {
  "$MISE_BIN" --cd "$HOME" --no-hooks exec -- afew "$@"
}

# Tag new messages by account and inbox location.
for account in {{ keys .mail.accounts | sortAlpha | join " " }}; do
  "$NOTMUCH_BIN" tag "+$account" -- "path:$account/** and tag:new"
  "$NOTMUCH_BIN" tag +inbox -- "folder:$account/INBOX and tag:new"
done

# Keep new until filing succeeds; the afew move rules also require tag:new.
afew --tag --new
# afew 4.0.2 can exit zero after a failed reindex. Propagate that specific error.
afew --move-mails --notmuch-args=--no-hooks 2>&1 |
  awk '{ print } /^ERROR:root:Could not update notmuch database / { failed = 1 } END { exit failed }'
"$NOTMUCH_BIN" tag -inbox -- tag:new and tag:invoice
"$NOTMUCH_BIN" tag -new -- tag:new

# Sync folder location → tags (runs on all messages, not just new)
{{ $notmuch }} tag -inbox -unread +trash -- path:fastmail/Trash/** and \(tag:inbox or tag:unread\)
{{ $notmuch }} tag -inbox -unread +trash -- path:gmail/Trash/** and \(tag:inbox or tag:unread\)
{{ $notmuch }} tag -inbox -unread +trash -- path:gmx/Trash/** and \(tag:inbox or tag:unread\)
{{ $notmuch }} tag -inbox -unread +spam  -- path:fastmail/Spam/** and \(tag:inbox or tag:unread\)
{{ $notmuch }} tag -inbox -unread +spam  -- path:gmx/Spam/** and \(tag:inbox or tag:unread\)
