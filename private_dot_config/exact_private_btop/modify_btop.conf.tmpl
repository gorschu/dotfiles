#!/bin/bash
# shellcheck disable=all
# Set the managed theme while preserving btop's other settings and comments.

set -euo pipefail

{{- $theme := "Default" }}
{{- if eq .colorscheme.name "tokyonight" }}
{{- $theme = printf "tokyonight_%s" .colorscheme.flavor }}
{{- else if eq .colorscheme.name "catppuccin" }}
{{- $theme = printf "catppuccin_%s" .colorscheme.flavor }}
{{- end }}
awk -v theme={{ $theme | shellQuote }} '
  BEGIN { setting = "color_theme = \"" theme "\"" }
  /^[[:space:]]*color_theme[[:space:]]*=/ { $0 = setting; found = 1 }
  { print }
  END { if (!found) print setting }
'
