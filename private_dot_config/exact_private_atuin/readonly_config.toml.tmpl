# Managed by chezmoi. Keep preferences here; rely on Atuin's defaults otherwise.
# Existing XDG config/data locations remain supported by Atuin 18.24.
# https://docs.atuin.sh/main/configuration/config/

auto_sync = true
update_check = true
# Used without the daemon; keep the daemon's interval below in sync.
sync_frequency = "10m"

# The daemon keeps a fast in-memory index with frequency/recency ranking.
search_mode = "daemon-fuzzy"
workspaces = true

style = "auto"
inline_height = 35
show_preview = true
show_help = true
enter_accept = true
keymap_mode = "vim-insert"

# Apply Atuin's built-in credential detection to history and captured content.
secrets_filter = true

[search]
filters = ["workspace", "global", "host", "session", "directory"]

[daemon]
enabled = true
# Atuin manages its lifecycle, including upgrades, without a separate systemd unit.
autostart = true
sync_frequency = "10m"

[pty_proxy]
# Restore terminal output after closing the inline UI, including outside tmux.
# `atuin init` starts the proxy automatically.
enabled = true

[threads]
# Capture and sync agent conversations, tool inputs/outputs, and edit diffs.
capture = true
capture_tools = true
# Match history's workspace-first behavior; falls back to global when needed.
filter_mode = "workspace"

[security]
# Extend built-in exclusions for relocated agent credentials and decrypted files.
sensitive_files = [
  "~/.config/claude/.credentials.json",
  "~/.config/codex/auth.json",
  "~/data/general/ai/claude/.credentials.json",
  "~/data/general/ai/codex/auth.json",
  "*.dec",
]

[tmux]
enabled = true
