// Niri already floats parented dialogs and fixed-size utility windows. Keep
// explicit rules narrow so ordinary applications remain tiled.
// Draw the focus ring as an actual outline so square client surfaces do not
// cover its rounded corners. Clip client surfaces to the same rounded shape.
window-rule {
    geometry-corner-radius 8
    draw-border-with-background false
    clip-to-geometry true
}

window-rule {
    match app-id=r#"(?i)^1password$"# title=r#"(?i).*quick access.*"#
    open-floating true
    default-column-width { fixed 900; }
}

window-rule {
    match app-id=r#"(?i)^vicinae(-server)?$"#
    open-floating true
}

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
}

window-rule {
    match app-id=r#"(?i)firefox$"# title=r#"^Picture-in-Picture$"#
    open-floating true
}
