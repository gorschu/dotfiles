[Unit]
Description=Noctalia shell for the Niri work session
Documentation=https://docs.noctalia.dev
PartOf=graphical-session.target
After=graphical-session.target plasma-kded6.service plasma-knighttimed.service
Wants=plasma-kded6.service plasma-knighttimed.service

[Service]
Type=notify
NotifyAccess=all
Slice=session.slice
ExecStart=%h/.local/libexec/niri-noctalia-start
ExecStopPost=%h/.local/libexec/niri-idle-brightness restore
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
