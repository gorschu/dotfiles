# https://github.com/drduh/config/blob/master/gpg-agent.conf
# https://www.gnupg.org/documentation/manuals/gnupg/Agent-Options.html
ttyname $GPG_TTY
# Expire cached passphrases after 4 hours of inactivity.
default-cache-ttl 14400
# Require the passphrase again after 8 hours, even with continued use.
max-cache-ttl 28800
# don't grab all input
no-grab
# work around gnome-keyring issues
no-allow-external-cache
# don't user cache when signing stuff
#ignore-cache-for-signing

{{ if has (lower (env "XDG_CURRENT_DESKTOP")) (list "kde" "niri" "hyprland") -}}pinentry-program /usr/bin/pinentry-qt
{{ else if eq (lower (env "XDG_CURRENT_DESKTOP") ) "gnome" -}}pinentry-program /usr/bin/pinentry-gnome3
{{ end -}}
