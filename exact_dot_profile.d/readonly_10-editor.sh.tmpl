{{- $brewPrefix := .homebrew.prefix -}}
{{- if .is_work_machine -}}
  {{- $brewPrefix = "${HOME}/homebrew" -}}
{{- end -}}
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
elif [ -x "{{ $brewPrefix }}/bin/nvim" ]; then
  # Login and desktop sessions may not have Homebrew on PATH yet.
  export EDITOR="{{ $brewPrefix }}/bin/nvim"
else
  export EDITOR="vi"
fi
export GIT_EDITOR="$EDITOR"
export VISUAL="$EDITOR"
